# Copy to .env.local. These are public (sent to the browser), so never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_CENTER=40.7000,-73.9500
NEXT_PUBLIC_MAP_ZOOM=11
# The app's public web address, used in the printable park guide's QR codes and the quiz's shared score link (e.g. https://your-app.example.org).
# Leave empty to use this browser's address, but "localhost" only works on this computer, not on a phone.
NEXT_PUBLIC_SITE_URL=

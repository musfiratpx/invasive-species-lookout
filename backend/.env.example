# Copy this file to .env and fill in what you have.
# The app runs with ALL of these empty (local keyword search, no AI, no music).
# Never commit .env.

# --- Area ---
INAT_PLACE_IDS=125479           # Kissena Park; add 125415 for Kissena Corridor Park (comma-separated)
AREA_LAT=40.741
AREA_LNG=-73.812
AREA_RADIUS_KM=2

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=                   # e.g. a current Flash model from Google AI Studio

# --- Snowflake (RAG retrieval) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PAT=                  # programmatic access token, or use key-pair auth
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=INVASIVE_WATCH
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_SEARCH_SERVICE=KNOWLEDGE_SEARCH

# --- ElevenLabs (background music script only) ---
ELEVENLABS_API_KEY=

# --- App ---
FRONTEND_ORIGIN=http://localhost:3000

# Copy this file to .env and fill in what you have.
# The app runs with ALL of these empty (local keyword search, no AI, no music).
# Never commit .env.
#An environment file is configured but terminal environment injection is disabled. Enable "python.terminal.useEnvFile" to use environment variables from .env files in terminals.
# --- Area ---
# Default: a 2 km circle covering Kissena Park AND Queens College.
# Optional: exact park boundaries instead (leaves out QC): 125479 = Kissena Park, 125415 = Kissena Corridor Park
INAT_PLACE_IDS=
AREA_LAT=40.741
AREA_LNG=-73.812
AREA_RADIUS_KM=2

# --- Snowflake (RAG: Cortex Search finds the text, Cortex chat writes it) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
export SNOWFLAKE_PAT=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=INVASIVE_WATCH
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_SEARCH_SERVICE=KNOWLEDGE_SEARCH
SNOWFLAKE_CORTEX_MODEL=

# --- ElevenLabs (background music script only) ---
export ELEVENLABS_API_KEY=

# --- App ---
FRONTEND_ORIGIN=http://localhost:3000

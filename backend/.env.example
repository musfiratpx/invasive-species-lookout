# Copy this file to .env and fill in what you have. Never commit .env.
# The app runs with ALL of these empty: local keyword search, fact-sheet text
# word for word, no music. (Lines may start with "export " too; both work.)

# --- Area ---
# Default: all of New York City (iNaturalist place 674, all five boroughs).
# Others: 675 = Queens County, 125479 = Kissena Park, 125415 = Kissena Corridor Park.
# Leave empty to use the 2 km circle around Kissena Park + Queens College below.
# After changing the area, rerun the fetch scripts (see README).
INAT_PLACE_IDS=674
AREA_LAT=40.741
AREA_LNG=-73.812
AREA_RADIUS_KM=2

# --- Snowflake (RAG retrieval with Cortex Search) ---
# Fill these in to search the fact sheets with Cortex Search instead of keywords.
# Setup: run backend/snowflake/setup.sql, then scripts/load_chunks.py.
SNOWFLAKE_ACCOUNT=              # e.g. myorg-myaccount (without .snowflakecomputing.com)
SNOWFLAKE_USER=
SNOWFLAKE_PAT=                  # programmatic access token (your user needs a network policy to use one)
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=            # e.g. COMPUTE_WH
SNOWFLAKE_DATABASE=INVASIVE_WATCH
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_SEARCH_SERVICE=KNOWLEDGE_SEARCH
# Optional: a Cortex model to rewrite Summary/History/Seasons, e.g. claude-haiku-4-5.
# Leave EMPTY to show fact-sheet text word for word (the team's choice; see docs/ROLES.md).
SNOWFLAKE_CORTEX_MODEL=

#--- Tiger database ---
export TIGER_DATABASE_URL=


# --- ElevenLabs (background music script only) ---
ELEVENLABS_API_KEY=

# --- App ---
# Websites allowed to call the API; separate several with commas.
FRONTEND_ORIGIN=http://localhost:3000
